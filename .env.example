# API key for authenticating requests to this microservice
XHS_API_KEY=your-secret-api-key-here

# HMAC secret for short-lived browser upload tokens
UPLOAD_TOKEN_SECRET=your-independent-upload-token-secret-here

# Data directory for persistent storage (cookie, QR state)
DATA_DIR=/app/data

# Upload directory for images before publishing
UPLOAD_DIR=/app/data/uploads

# Comma-separated HTTPS MEDIA delivery hosts accepted by /publish-video-url
TRUSTED_MEDIA_VIDEO_HOSTS=images.xhs.justlikekatie.com

# Maximum remote MP4 size in bytes (default: 500 MiB)
MAX_REMOTE_VIDEO_BYTES=524288000

# Maximum total MEDIA download duration in seconds
REMOTE_VIDEO_DOWNLOAD_TIMEOUT_SECONDS=300

# Path to stealth.min.js (anti-detection for Playwright)
STEALTH_JS_PATH=/app/stealth.min.js

# Port (Railway sets this automatically)
PORT=8000
