# API key for authenticating requests to this microservice
XHS_API_KEY=your-secret-api-key-here

# Data directory for persistent storage (cookie, QR state)
DATA_DIR=/app/data

# Upload directory for images before publishing
UPLOAD_DIR=/app/data/uploads

# Path to stealth.min.js (anti-detection for Playwright)
STEALTH_JS_PATH=/app/stealth.min.js

# Port (Railway sets this automatically)
PORT=8000
